{
	"name": "my-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:zed-proxy": "bun test scripts/zedEditNormalizer.test.ts scripts/cursorPayloadUtils.test.ts scripts/evalZedProxyCaptures.test.ts scripts/zedExternalProtocol.test.ts",
		"probe:zed-proxy": "bun run scripts/probeZedProxy.ts",
		"eval:zed-proxy": "bun run scripts/evalZedProxyCaptures.ts",
		"verify:zed-macos": "bun run scripts/verifyZedCursorTab.ts",
		"install:zed-macos": "bash scripts/macos/install-zed-cursor-tab.sh",
		"update:zed-macos": "bash scripts/macos/update-zed-cursor-tab.sh",
		"status:zed-macos": "bash scripts/macos/status-zed-cursor-tab.sh",
		"zed-proxy": "bun run scripts/zedExternalProxy.ts",
		"streamCpp": "bun run scripts/streamCpp.ts",
		"refreshTabContext": "bun run scripts/refreshTabContext.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"monaco-editor": "^0.55.1",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"typescript": "^5.9.3",
		"vite": "^7.2.6",
		"vite-plugin-monaco-editor": "^1.1.0"
	},
	"dependencies": {
		"@elysiajs/static": "^1.4.7",
		"@sveltejs/enhanced-img": "^0.9.2",
		"@tailwindcss/vite": "^4.1.18",
		"elysia": "^1.4.19",
		"protobufjs": "^8.0.0",
		"tailwindcss": "^4.1.18"
	}
}
